Windows Registry Editor Version 5.00

; ============================================================
; IMAGE FORMATS CONTEXT MENU (HKLM)
; ============================================================

[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\SystemFileAssociations\image\shell\AVICore]
"MUIVerb"="AVI Core"
"SubCommands"=""
"MultiSelectModel"="Player"
"Icon"="\"C:\\Program Files\\AVI Core\\logo.ico\""

; --- Convert Submenu ---
[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\SystemFileAssociations\image\shell\AVICore\shell\1_Convert]
"MUIVerb"="Convert"
"SubCommands"=""
"MultiSelectModel"="Player"
"Icon"="\"C:\\Program Files\\AVI Core\\logo.ico\""

[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\SystemFileAssociations\image\shell\AVICore\shell\1_Convert\shell\JPG]
"MUIVerb"="Convert To JPG"
"MultiSelectModel"="Player"
"AppliesTo"="NOT System.FileExtension:=.jpg"

[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\SystemFileAssociations\image\shell\AVICore\shell\1_Convert\shell\JPG\command]
@="\"C:\\Program Files\\AVI Core\\context_menu.exe\" \"convert\" \"jpg\" \"%1\""

[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\SystemFileAssociations\image\shell\AVICore\shell\1_Convert\shell\JPEG]
