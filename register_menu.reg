@="\"C:\\Program Files\\AVI Core\\context_menu.exe\" \"convert\" \"png\" \"%1\""

[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\SystemFileAssociations\image\shell\AVICore\shell\1_Convert\shell\WEBP]
"MUIVerb"="Convert To WEBP"
"MultiSelectModel"="Player"
"AppliesTo"="NOT System.FileExtension:=.webp"

[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\SystemFileAssociations\image\shell\AVICore\shell\1_Convert\shell\WEBP\command]
@="\"C:\\Program Files\\AVI Core\\context_menu.exe\" \"convert\" \"webp\" \"%1\""

